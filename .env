# =============================================================
# CaraBot Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================

# --- API Authentication (Required) ---
API_KEY=sk-0d40cd58b0fe44b29bb61141937afbe4

# --- Vector Store ---
# Options: milvus | chroma
VECTOR_STORE_TYPE=milvus

# Milvus Configuration (used when VECTOR_STORE_TYPE=milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=Milvus
MILVUS_COLLECTION_NAME=carabot_knowledge
MILVUS_DIMENSION=1024

# Chroma Configuration (used when VECTOR_STORE_TYPE=chroma)
CHROMA_PERSIST_DIR=./data/chroma_v2
CHROMA_COLLECTION_NAME=carabot_knowledge

# --- Embedding Model ---
BGE_MODEL_NAME=BAAI/bge-m3
# Local path for model caching. If empty, defaults to HuggingFace cache
BGE_MODEL_PATH=./data/models/bge-m3
# Device: cpu | cuda
BGE_DEVICE=cpu
BGE_BATCH_SIZE=32

# --- Database ---
# PostgreSQL connection string (asyncpg driver)
DB_URL=postgresql+asyncpg://carabot:carabot@localhost:5432/carabot
# Synchronous URL for Alembic migrations
DB_URL_SYNC=postgresql+psycopg2://carabot:carabot@localhost:5432/carabot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# Redis queue name for indexing tasks
REDIS_INDEX_QUEUE=carabot:index:queue

# --- Document Processing ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# --- Retrieval ---
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/carabot.log
# Log format: json | text
LOG_FORMAT=json

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Workers for production (uvicorn)
WORKERS=4
